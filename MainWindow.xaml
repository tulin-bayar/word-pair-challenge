<Window x:Class="WordPairChallenge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Word Pair Challenge" Width="880" Height="695" MinWidth="660" MinHeight="555"
    WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#131226">
    <Window.Resources>
        <SolidColorBrush x:Key="Back" Color="#352E58"/>
        <SolidColorBrush x:Key="Open" Color="#EEE9FF"/>
        <SolidColorBrush x:Key="Solved" Color="#88E7C3"/>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#5D548D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D5B6FF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFB65C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="BorderBrush" Value="#55BB99"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="HomeScreen" Margin="24" CornerRadius="22" Background="#242238">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="490">
                <TextBlock Text="Word Pair Challenge" FontSize="44" FontWeight="Bold" Foreground="#F9F7FF"/>
                <TextBlock Text="Match each software term to its definition. Find all eight pairs in 10 moves or fewer to earn three stars."
                           TextWrapping="Wrap" FontSize="18" Foreground="#E7E1FF" Margin="0,10,0,26"/>
                <Button Content="Start Game" Click="NewGame_Click" HorizontalAlignment="Left" Padding="24,12" Style="{StaticResource RoundedButton}"
                        Background="#B9F782" Foreground="#17291F" FontWeight="Bold" FontSize="17"/>
            </StackPanel>
        </Border>
    <Grid x:Name="GameScreen" Visibility="Collapsed" Margin="24,18" TextElement.Foreground="#F9F7FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="18" Padding="20,15" Background="#242238">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="NewGame_Click" VerticalAlignment="Center"
                        Background="#B9F782" Foreground="#17291F" BorderBrush="#B9F782" Padding="16,8"
                        FontWeight="Bold" FontSize="14" Style="{StaticResource RoundedButton}" Content="New Game"/>
                <Button DockPanel.Dock="Right" Click="Home_Click" Content="Home" VerticalAlignment="Center"
                        Background="#352E58" Foreground="White" Padding="14,8" Margin="0,0,8,0"
                        ToolTip="End this round and return to the start screen" Style="{StaticResource RoundedButton}"/>
                <StackPanel>
                    <TextBlock Text="Word Pair Challenge" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Match each software term with its definition." Foreground="#DED8F5" FontSize="15"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="5,13,5,7">
            <TextBlock x:Name="PairsLabel" DockPanel.Dock="Right" FontFamily="Consolas" Foreground="#B9F782" FontSize="15"/>
            <TextBlock x:Name="MovesLabel" DockPanel.Dock="Left" FontFamily="Consolas" Foreground="#EEE8FF" FontSize="15"/>
            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Left" Margin="18,0,0,0" FontFamily="Consolas" Foreground="#DACFFF" FontSize="15"/>
            <ProgressBar x:Name="Progress" Height="5" Maximum="8" Margin="20,0" Foreground="#A198FF" Background="#38344C" BorderThickness="0"/>
        </DockPanel>
        <UniformGrid x:Name="Board" Grid.Row="2" Rows="4" Columns="4"/>
    </Grid>
        <Grid x:Name="ResultsOverlay" Visibility="Collapsed" Background="#AE0C0C1C"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#27233E" BorderBrush="#7664AC" BorderThickness="1" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="Board complete!" Foreground="White" FontSize="27"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultStars" Foreground="#FFCC66" FontFamily="Segoe UI Symbol"
                               FontSize="40" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                    <UniformGrid Columns="2" Rows="1" TextElement.Foreground="#F9F7FF">
                        <StackPanel>
                            <TextBlock Text="Time (min:sec)" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ResultTime" FontSize="24" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Moves" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ResultMoves" FontSize="24" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Rows="1" Margin="0,20,0,0">
                        <Button x:Name="ResultRestart" Click="NewGame_Click" Content="Restart"
                                Style="{StaticResource RoundedButton}" Background="#B9F782" Foreground="#17291F"
                                Padding="16,8" Margin="0,0,4,0" FontWeight="Bold"/>
                        <Button Click="Home_Click" Content="Home" Style="{StaticResource RoundedButton}"
                                Background="#352E58" Foreground="White" Padding="16,8" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
